# ==============================================================================
# Ambiently — Optional Environment Variables (.env)
# Copy to `.env` for local Vite development OR Docker Compose self-hosting.
# Ambiently works 100% offline/locally out of the box without any variables set.
# ==============================================================================

# Host HTTP port when running via `docker compose up -d` (default: 8080)
AMBIENTLY_PORT=8080

# Container timezone for server logs & date calculations
TZ=America/Chicago

# Optional: Supabase Cloud Sync (works at runtime in Docker via SUPABASE_* or at Vite build-time via VITE_SUPABASE_*)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional (Self-Hosted Docker / Raspberry Pi ONLY):
# Set to "true" ONLY on trusted private home networks to allow LAN http://, 192.168.x.x, 10.x.x.x,
# and .local/.lan calendar (.ics) and RSS feeds (e.g., Nextcloud, Radicale, Home Assistant, FreshRSS).
# Loopback (127.0.0.1 / localhost) and cloud metadata (169.254.169.254) remain blocked at all times.
AMBIENTLY_ALLOW_PRIVATE_FEEDS=false
